MulBench:
    Int wrap
    Int iterations

    init(Int iterations, Int wrap):
        this.iterations = iterations
        this.wrap = wrap

    Int step(Int acc, Int i):
        acc = toInt32(acc * 3)
        acc = toInt32(acc + i)
        if (acc < 0):
            acc = toInt32(acc + wrap)
        if (acc > wrap):
            acc = toInt32(acc - wrap)
        return acc

    Int run():
        Int i = 0
        Int acc = 1
        while (i < iterations):
            acc = this.step(acc, i)
            i = i + 1
        return acc

Int toInt32(Int v):
    Int mod = 4294967296
    v = v % mod
    if (v < 0):
        v = v + mod
    if (v > 2147483647):
        v = v - mod
    return v

Int main(String[] args):
    Int iterations = 100000000
    Int wrap = 1000000
    Int argc = args.count()
    if (argc > 0):
        iterations = args.getInt(0)
    if (argc > 1):
        wrap = args.getInt(1)
    MulBench bench = MulBench.new()
    bench.init(iterations, wrap)
    Int checksum = bench.run()
    "Iterations: %i".println(iterations)
    "Wrap: %i".println(wrap)
    "Checksum: %i".println(checksum)

    return 0
