# Prime performance benchmark: count primes up to LIMIT

Prime:
    Bool isPrime(Int n):
        if (n <= 1):
            return false
        if (n == 2):
            return true
        # even check using integer math: n % 2 == 0 -> (n / 2) * 2 == n
        if ((n / 2) * 2 == n):
            return false
        Int i = 3
        while ((i * i) <= n):
            # remainder check: n % i == 0 -> n - (n / i) * i == 0
            if (n - (n / i) * i == 0):
                return false
            i = i + 2
        return true

Int main():
        Int LIMIT = 10000000
        Int count = 0
        Prime p = Prime.new()
        Int n = 2
        while (n <= LIMIT):
            if (p.isPrime(n)):
                count = count + 1
            n = n + 1
        "primes up to %i: %i".println(LIMIT, count)
        return 0
