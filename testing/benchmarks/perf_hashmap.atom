# Hash map benchmark (simulate with array for Atom)

HashMapBench:
    Int n
    Int[] keys
    Int[] values

    init(Int n):
        this.n = n
        this.keys = Int[n]
        this.values = Int[n]
        Int i = 0
        while (i < n):
            this.keys[i] = i * 17 % n
            this.values[i] = i
            i = i + 1

    Int run():
        Int sum = 0
        Int i = 0
        while (i < n):
            Int key = keys[i]
            Int j = 0
            Int found = 0
            while (j < n):
                if (found == 0 && keys[j] == key):
                    sum = sum + values[j]
                    found = 1
                j = j + 1
            i = i + 1
        return sum

Int main(String[] args):
        Int n = 100000
        Int argc = args.count()
        if (argc > 0):
            n = args.getInt(0)
        HashMapBench bench = HashMapBench.new(n)
        Int result = bench.run()
        "N: %i".println(n)
        "Result: %i".println(result)
        return 0
