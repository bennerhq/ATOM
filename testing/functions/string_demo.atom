# Comprehensive String Feature Demo

StringDemo:
    Int demonstrateBasics():
        "=== String Basics Demo ===".println()
        
        # Simple string variables
        String hello = "Hello"
        String world = "World"
        "Hello: ".print()
        hello.println()
        "World: ".print()
        world.println()
        
        # String with special characters
        String quote = "She said \"Hello\""
        String newline = "Line 1\nLine 2"
        String path = "C:\\Users\\Documents"
        "Quote: ".println()
        quote.println()
        "Newline test:".println()
        newline.println()
        "Path: ".println()
        path.println()
        
        # Empty string
        String empty = ""
        "Empty string (should be blank):".println()
        empty.println()
        
        return 0
    
    String demonstrateParameters(String msg, String prefix, String suffix):
        "=== String Parameters Demo ===".println()
        "Message: ".print()
        msg.println()
        "Prefix: ".print()
        prefix.println()
        "Suffix: ".print()
        suffix.println()
        # String parameters work perfectly
        return msg
    
    Int demonstrateMultiple():
        "=== Multiple Strings Demo ===".println()
        # Multiple strings in one method
        String s1 = "First"
        String s2 = "Second"
        String s3 = "Third"
        String s4 = "Fourth"
        String s5 = "Fifth"
        
        s1.println()
        s2.println()
        s3.println()
        s4.println()
        s5.println()
        
        # Test reuse of strings
        String s6 = "First"
        String s7 = "Second"
        "Reused: ".print()
        s6.println()
        "Reused: ".print()
        s7.println()
        
        return 0
    
    String demonstrateConditionals(Bool flag):
        "=== String Conditionals Demo ===".println()
        String result = "default"
        
        if (flag):
            result = "flag was true"
        else:
            result = "flag was false"
        
        "Result: ".print()
        result.println()
        return result
    
    Int demonstrateLoops():
        "=== String Loops Demo ===".println()
        Int counter = 0
        String message = "Loop iteration completed"
        
        while (counter < 5):
            message.println()
            counter = counter + 1
        
        return counter
    
    Int main():
        "========================================".println()
        "    ATOM STRING FEATURE DEMONSTRATION   ".println()
        "========================================".println()
        "".println()
        
        # Test all features
        Int result = this.demonstrateBasics()
        "".println()
        
        String msg = this.demonstrateParameters("Hello", "[", "]")
        "".println()
        
        result = this.demonstrateMultiple()
        "".println()
        
        String conditional = this.demonstrateConditionals(true)
        "".println()
        
        result = this.demonstrateLoops()
        "".println()
        
        "=== Final Messages ===".println()
        String welcome = "Welcome to Atom!"
        String goodbye = "Goodbye!"
        welcome.println()
        goodbye.println()
        
        "".println()
        "========================================".println()
        "    DEMO COMPLETE                      ".println()
        "========================================".println()
        
        return 0

Int main():
        StringDemo demo = StringDemo.new()
        return demo.main()
