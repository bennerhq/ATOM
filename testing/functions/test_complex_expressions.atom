# Test complex expressions and control flow

MathOps:
    Int gcd(Int a, Int b):
        while (b != 0):
            Int temp = b
            b = a - (a / b) * b
            a = temp
        return a
    
    Int lcm(Int a, Int b):
        Int g = this.gcd(a, b)
        return (a / g) * b
    
    Int isPrime(Int n):
        if (n <= 1):
            return 0
        else:
            if (n == 2):
                return 1
            else:
                if (n / 2 * 2 == n):
                    return 0
                else:
                    Int i = 3
                    while (i * i <= n):
                        if (n - (n / i) * i == 0):
                            return 0
                        else:
                            i = i + 2
                    return 1

