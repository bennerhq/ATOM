# Stress test with many operations and state changes

Stress:
    Int compute():
        Int sum = 0
        Int product = 1
        Int i = 1
        
        while (i <= 20):
            sum = sum + i
            
            if (i <= 10):
                product = product * 2
            
            Int j = 0
            while (j < 5):
                sum = sum + 1
                j = j + 1
            
            i = i + 1
        
        Int result = sum + product
        return result
    
    Int nestedCompute():
        Int total = 0
        Int a = 0
        
        while (a < 10):
            Int b = 0
            while (b < 10):
                Int c = 0
                while (c < 3):
                    total = total + (a + b + c)
                    c = c + 1
                b = b + 1
            a = a + 1
        
        return total

Int main():
        "=== Stress Test ===".println()
        
        Stress s = Stress.new()
        
        "compute: %i".println(s.compute())
        "nestedCompute: %i".println(s.nestedCompute())
        
        return 0
