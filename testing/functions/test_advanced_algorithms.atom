# Advanced: Complex algorithm - Collatz conjecture and analysis

MathAnalyzer:
    Int collatzLength(Int n):
        Int length = 0
        while (n != 1):
            if (n / 2 * 2 == n):
                n = n / 2
            else:
                n = n * 3 + 1
            length = length + 1
        return length
    
    Int maxCollatzBelow(Int limit):
        Int maxLen = 0
        Int maxNum = 0
        Int i = 1
        while (i < limit):
            Int len = this.collatzLength(i)
            if (len > maxLen):
                maxLen = len
                maxNum = i
            i = i + 1
        return maxNum

Analyzer:
    Int countDivisors(Int n):
        Int count = 0
        Int i = 1
        while (i <= n):
            if (n - (n / i) * i == 0):
                count = count + 1
            i = i + 1
        return count
    
    Int sumDigits(Int n):
        Int sum = 0
        while (n > 0):
            sum = sum + (n - (n / 10) * 10)
            n = n / 10
        return sum

