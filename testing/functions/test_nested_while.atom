# Nested while loops with early exit conditions

Matrix:
    Int findTarget(Int target):
        Int i = 0
        Int found = 0
        
        while (i < 5):
            Int j = 0
            while (j < 5):
                Int value = i * 5 + j
                if (value == target):
                    found = 1
                    j = 100  # Force exit of inner loop
                j = j + 1
            i = i + 1
        
        return found
    
    Int sumUpperTriangle():
        Int sum = 0
        Int i = 0
        
        while (i < 5):
            Int j = i
            while (j < 5):
                sum = sum + (i * 5 + j)
                j = j + 1
            i = i + 1
        
        return sum

Int main():
        "=== Nested While Loops Test ===".println()
        
        Matrix m = Matrix.new()
        
        "findTarget(12) = %i".println(m.findTarget(12))
        "findTarget(99) = %i".println(m.findTarget(99))
        "sumUpperTriangle() = %i".println(m.sumUpperTriangle())
        
        return 0
