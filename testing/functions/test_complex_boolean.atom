# Complex boolean logic expressions

LogicEvaluator:
    Int evaluate(Int a, Int b, Int c, Int d):
        Int result = 0
        if (a > 0):
            if (b > 0):
                if (c > 0):
                    if (d > 0):
                        result = 1
                    else:
                        result = 2
                else:
                    if (d > 0):
                        result = 3
                    else:
                        result = 4
            else:
                if (c > 0):
                    result = 5
                else:
                    result = 6
        else:
            if (b > 0):
                result = 7
            else:
                result = 8
        return result

Int main():
        "=== Complex Boolean Logic Test ===".println()
        
        LogicEvaluator eval = LogicEvaluator.new()
        
        "eval(1,1,1,1) = %i".println(eval.evaluate(1, 1, 1, 1))
        "eval(1,1,1,0) = %i".println(eval.evaluate(1, 1, 1, 0))
        "eval(1,1,0,1) = %i".println(eval.evaluate(1, 1, 0, 1))
        "eval(1,0,1,0) = %i".println(eval.evaluate(1, 0, 1, 0))
        "eval(0,1,0,0) = %i".println(eval.evaluate(0, 1, 0, 0))
        "eval(0,0,0,0) = %i".println(eval.evaluate(0, 0, 0, 0))
        
        return 0
