ControlFlow:
    Int testIf():
        "".println()
        "=== If Statements ===".println()
        Int x = 10
        if (x > 5):
            "x > 5: true".println()
        if (x < 5):
            "x < 5: true".println()
        else:
            "x < 5: false".println()
        return 0
    
    Int testWhile():
        "".println()
        "=== While Loop ===".println()
        Int i = 0
        Int sum = 0
        while (i < 5):
            sum = sum + i
            i = i + 1
        "Sum 0-4: %i".println(sum)
        return 0

