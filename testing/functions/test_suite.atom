MathOps:
    Int testArithmetic():
        String title1 = "=== " + "Arithmetic Operations" + " ==="
        title1.println()
        String arith1 = "5 + 3 = " + "%i"
        arith1.println(5 + 3)
        String arith2 = "10 - 4 = " + "%i"
        arith2.println(10 - 4)
        String arith3 = "6 * 7 = " + "%i"
        arith3.println(6 * 7)
        String arith4 = "20 / 4 = " + "%i"
        arith4.println(20 / 4)
        return 0
    
    Int testComparison():
        "".println()
        String title2 = "=== " + "Comparison Operations" + " ==="
        title2.println()
        String cmp1 = "5 < 10: " + "%b"
        cmp1.println(5 < 10)
        String cmp2 = "10 > 5: " + "%b"
        cmp2.println(10 > 5)
        String cmp3 = "5 == 5: " + "%b"
        cmp3.println(5 == 5)
        String cmp4 = "5 != 10: " + "%b"
        cmp4.println(5 != 10)
        String cmp5 = "5 <= 5: " + "%b"
        cmp5.println(5 <= 5)
        "10 >= 5: %b".println(10 >= 5)
        return 0
    
    Int testNegatives():
        "".println()
        "=== Negative Numbers ===".println()
        Int neg = -42
        "Negative: %i".println(neg)
        "Double negative: %i".println(0 - neg)
        "-100 + 50 = %i".println(-100 + 50)
        return 0

