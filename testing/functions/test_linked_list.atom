# Advanced: Linked List implementation

Node:
    Int value = 0
    Node next = null
    
    Int getValue():
        return this.value

LinkedList:
    Node head = null
    Int size = 0
    
    Int append(Int val):
        Node newNode = Node.new()
        newNode.value = val
        if (this.head == null):
            this.head = newNode
        else:
            Node current = this.head
            while (current.next != null):
                current = current.next
            current.next = newNode
        this.size = this.size + 1
        return this.size
    
    Int getAt(Int index):
        if (index >= this.size):
            return -1
        else:
            Node current = this.head
            Int i = 0
            while (i < index):
                current = current.next
                i = i + 1
            return current.getValue()
    
    Int getSize():
        return this.size

