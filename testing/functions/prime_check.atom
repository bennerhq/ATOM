# Prime checker: pass integer via function arg

Prime:
    Bool isPrime(Int n):
        if (n <= 1):
            return false
        if (n == 2):
            return true
        if ((n / 2) * 2 == n):
            return false
        Int i = 3
        while ((i * i) <= n):
            if (n - (n / i) * i == 0):
                return false
            i = i + 2
        return true

Int main(Int n):
        Prime p = Prime.new()
        Bool ans = p.isPrime(n)
        "%i is prime: %b".println(n, ans)
        return 0
